// Contrato de PostgreSQL: `public` contiene operación/usuarios y `knowledge`
// contiene reglas y análisis derivados por el Motor Inteligente.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "knowledge"]
}

enum Role {
  ADMIN
  AUDITOR
  VIEWER

  @@schema("public")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED

  @@schema("public")
}

enum AuditStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("public")
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  REMOVED

  @@schema("public")
}

enum FindingStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  ACCEPTED
  FALSE_POSITIVE

  @@schema("public")
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("public")
}

model User {
  // active bloquea el acceso sin eliminar proyectos ni trazabilidad histórica.
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  role              Role               @default(AUDITOR)
  active            Boolean            @default(true)
  projects          Project[]
  auditLogs         AuditLog[]
  pushSubscriptions PushSubscription[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([role])
  @@index([active])
  @@schema("public")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@schema("public")
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  audits      Audit[]
  auditLogs   AuditLog[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ownerId])
  @@index([status])
  @@schema("public")
}

model Audit {
  id          String      @id @default(uuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      AuditStatus @default(DRAFT)
  startedAt   DateTime?
  completedAt DateTime?
  assets      Asset[]
  auditLogs   AuditLog[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@schema("public")
}

model Asset {
  id          String      @id @default(uuid())
  auditId     String
  audit       Audit       @relation(fields: [auditId], references: [id], onDelete: Cascade)
  name        String
  ip          String?
  type        String      @default("host")
  criticality String      @default("MEDIUM")
  status      AssetStatus @default(ACTIVE)
  riskScore   Float       @default(0)
  findings    Finding[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([auditId, name])
  @@index([auditId])
  @@index([status])
  @@index([criticality])
  @@index([riskScore])
  @@schema("public")
}

model Finding {
  // rawData conserva evidencia original; analysis almacena el resultado derivado.
  id                 String           @id @default(uuid())
  idempotencyKey     String?          @unique
  requestFingerprint String?
  assetId            String
  asset              Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  rawData            Json
  vulnerability      String?
  port               Int?
  status             FindingStatus    @default(OPEN)
  severity           Severity         @default(LOW)
  riskScore          Float            @default(0)
  processedAt        DateTime?
  analysis           FindingAnalysis?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([assetId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@schema("public")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditId    String?
  audit      Audit?   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([auditId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@schema("public")
}

model KnowledgeRule {
  id                String            @id @default(uuid())
  code              String?           @unique
  name              String
  type              String
  condition         Json
  baseRiskScore     Float
  mitreIds          String[]          @default([])
  owaspIds          String[]          @default([])
  cweIds            String[]          @default([])
  recommendation    String
  remediationEffort String            @default("MEDIUM")
  dependencies      String[]          @default([])
  priority          Int               @default(0)
  active            Boolean           @default(true)
  analyses          FindingAnalysis[] @relation("AnalysisRules")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([type, active])
  @@index([priority])
  @@index([remediationEffort])
  @@schema("knowledge")
}

model FindingAnalysis {
  id              String          @id @default(uuid())
  findingId       String          @unique
  finding         Finding         @relation(fields: [findingId], references: [id], onDelete: Cascade)
  inferredOs      String?
  inferredService String?
  inferredVersion String?
  calculatedRisk  Float
  riskBreakdown   Json?
  engineVersion   String          @default("1.0")
  matchedRules    Json
  rules           KnowledgeRule[] @relation("AnalysisRules")
  mitreTechniques String[]        @default([])
  owaspCategories String[]        @default([])
  cweIds          String[]        @default([])
  recommendations String[]        @default([])
  correlation     Json?
  timelineEvents  Json?
  explanation     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([calculatedRisk])
  @@index([createdAt])
  @@schema("knowledge")
}
